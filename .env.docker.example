# Host path to JDownloader's Folder Watch directory.
JDOWNLOADER_FOLDERWATCH_HOST=/home/media/docker/torrentvpn-app/jdownloader/config/folderwatch

# WebUI port. If using the Gluetun network override, publish this port on Gluetun.
CRAWLER_WEB_PORT=8096

# Existing FlareSolverr instance.
FLARESOLVERR_ENABLED=1
FLARESOLVERR_URL=http://127.0.0.1:8191/v1
FLARESOLVERR_TIMEOUT=120
FLARESOLVERR_ON=403,429,503

# Only needed with docker-compose.gluetun.yml.
# Set this to the actual Gluetun container name from `docker ps`.
GLUETUN_CONTAINER=gluetun

# Minimum seconds between requests to the same host. 0 disables the artificial delay.
CRAWLER_MIN_GAP=0
