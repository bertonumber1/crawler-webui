# Docker deployment uses .env.docker. These are the application defaults.
FLARESOLVERR_ENABLED=1
FLARESOLVERR_URL=http://192.168.0.182:8191/v1
FLARESOLVERR_TIMEOUT=120
FLARESOLVERR_ON=403,429,503
CW_FOLDERWATCH=/jdownloader/folderwatch
CW_DOWNLOAD_ROOT=/output/_CRAWLER
CW_DATA_DIR=/data

# Minimum seconds between requests to the same host. 0 disables the artificial delay.
CRAWLER_MIN_GAP=0

# MyJDownloader. With these set the crawler talks to JD's API directly:
# additions are confirmed at the time, JD's own ONLINE/OFFLINE verdict is
# visible, and dead packages can be removed. Without them it falls back to
# reading JD's save files, which works but can only look.
# The values are in JD's own settings under Settings > My.JDownloader.
CW_MYJD_EMAIL=
CW_MYJD_PASSWORD=
CW_MYJD_DEVICE=

# A cookies.txt exported from a browser, for boards that hide links from
# guests. Paste it into the Session panel instead of setting this by hand.
CW_COOKIES_FILE=

# ---------------------------------------------------------------- thanks
# Some boards (dark-decade and most foroactivo ones) only show a topic's
# download box to an account that has replied to it. That is why gated topics
# resolve to zero links: they are not blocked or stale, the links simply are
# not in the HTML yet, and no read-only crawl can ever reach them.
#
# This is the only part of the app that WRITES to the board, under your own
# account and in public, so it takes two switches and a queue before anything
# is sent. Unset, the feature is inert and its UI panel does not appear.
CW_THANKS_ENABLED=0
# Where it may post, ever. A URL on any other host is refused, not posted to.
CW_THANKS_HOSTS=foroactivo.com
# What to say. The UI takes a list, one per line, and picks at random -- the
# same eight words under every topic is the most mechanical thing an account
# can do.
CW_THANKS_MESSAGE=gracias amigo
# Pacing: three posts, then nothing for 25 minutes (1500s), each one 40-90s
# after the last. Also a ceiling per day, so a bug hits a cap not the board.
CW_THANKS_BURST=3
CW_THANKS_WINDOW=1500
CW_THANKS_SPACING=40-90
CW_THANKS_DAILY_MAX=24
# robots.txt says nothing about submitting a form, but this app has never
# fetched a disallowed path. "respect" refuses if /post is disallowed and the
# preview tells you so; "ignore" posts anyway.
CW_THANKS_ROBOTS=respect

# Only posts from the last N months, on every site (0 = no limit). The UI box
# "only the last N months" saves its own value, which wins over this.
CW_SINCE_MONTHS=0
