# Docker deployment uses .env.docker. These are the application defaults.
FLARESOLVERR_ENABLED=1
FLARESOLVERR_URL=http://192.168.0.182:8191/v1
FLARESOLVERR_TIMEOUT=120
FLARESOLVERR_ON=403,429,503
CW_FOLDERWATCH=/jdownloader/folderwatch
CW_DOWNLOAD_ROOT=/output/_CRAWLER
CW_DATA_DIR=/data

# Minimum seconds between requests to the same host. 0 disables the artificial delay.
CRAWLER_MIN_GAP=0

# MyJDownloader. With these set the crawler talks to JD's API directly:
# additions are confirmed at the time, JD's own ONLINE/OFFLINE verdict is
# visible, and dead packages can be removed. Without them it falls back to
# reading JD's save files, which works but can only look.
# The values are in JD's own settings under Settings > My.JDownloader.
CW_MYJD_EMAIL=
CW_MYJD_PASSWORD=
CW_MYJD_DEVICE=

# A cookies.txt exported from a browser, for boards that hide links from
# guests. Paste it into the Session panel instead of setting this by hand.
CW_COOKIES_FILE=
