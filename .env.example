# Docker deployment uses .env.docker. These are the application defaults.
FLARESOLVERR_ENABLED=1
FLARESOLVERR_URL=http://192.168.0.182:8191/v1
FLARESOLVERR_TIMEOUT=120
FLARESOLVERR_ON=403,429,503
CW_FOLDERWATCH=/jdownloader/folderwatch
CW_DOWNLOAD_ROOT=/output/_CRAWLER
CW_DATA_DIR=/data

# Minimum seconds between requests to the same host. 0 disables the artificial delay.
CRAWLER_MIN_GAP=0
